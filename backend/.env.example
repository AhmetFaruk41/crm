PORT=4000
DB_HOST=localhost
DB_USER=crm_user
DB_PASS=guclu-bir-sifre-koy
DB_NAME=noname_crm
JWT_SECRET=uzun-rastgele-bir-string-uret-min-32-karakter
COOKIE_NAME=noname_token
NODE_ENV=production
FRONTEND_ORIGIN=https://senin-domainin.com

# CAWELT sitesine blog içeriği değiştiğinde tazeleme webhook'u.
# Aynı sunucuda Next.js localhost'ta çalışıyorsa dahili adresi kullan.
SITE_REVALIDATE_URL=http://127.0.0.1:3000/api/revalidate
# Site ile CRM'de AYNI olmalı (Next.js tarafında REVALIDATE_SECRET).
SITE_REVALIDATE_SECRET=uzun-rastgele-ortak-bir-sir-uret

# Yüklenen blog kapak görselleri için CRM'in public adresi (mutlak URL üretir).
# Örn. panel crm.cawelt.com'da yayındaysa:
PUBLIC_BASE_URL=https://crm.cawelt.com
